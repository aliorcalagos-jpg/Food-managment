# Postgres connection. In production use your provider's *pooled* endpoint (with sslmode=require).
DATABASE_URL="postgresql://food:food@localhost:5432/food?schema=public"

# Optional. A direct (non-pooled) connection used only by `prisma migrate`. Needed when
# DATABASE_URL points at a pooler such as PgBouncer or Neon's pooled endpoint.
# DIRECT_URL=""

# Required, 32+ chars. Generate with: openssl rand -base64 32
# Use a different value per environment. Changing it signs everyone out.
SESSION_SECRET=""

# Optional. Max connections per server instance (default 5). Keep small on serverless.
# DATABASE_POOL_MAX=5
